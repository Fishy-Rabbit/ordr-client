{
    "include": ["src"],
    "exclude": ["node_modules", "bins", "build", "data"],
    "compilerOptions": {
        "target": "es2022",
        "lib": ["ES2022"],
        "module": "commonjs",
        "rootDir": "src",
        "outDir": "build",
        "types": ["node"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "sourceMap": false
    }
}
